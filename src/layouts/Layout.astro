---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import { STATES, CAT_THEME } from "../themes.js";
const { title = "bsws." } = Astro.props;
const isCatsPage = Astro.url.pathname.replace(/\/+$/, "") === "/cats";
---

<!doctype html>
<html lang="en" class={isCatsPage ? "theme-cat" : undefined}>
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jacquard+12+Charted&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/images/favicon.ico" />
    <!-- Apply the saved theme before first paint so page changes don't flash.
         The /cats page is themed by html.theme-cat instead. -->
    {!isCatsPage && (
      <script is:inline define:vars={{ STATES, CAT_THEME }}>
        try {
          const states =
            sessionStorage.getItem("catThemeUnlocked") === "true"
              ? [...STATES, CAT_THEME]
              : STATES;
          const v = parseInt(localStorage.getItem("themeIndex"), 10);
          const s = states[v >= 0 && v < states.length ? v : 0];
          const root = document.documentElement;
          root.style.setProperty("--primary-color", s.bg);
          root.style.setProperty("--secondary-color", s.fg);
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <Navbar />
    <slot />
    <!-- oneko cursor-chasing cat (black cat, white outline) -->
    <script is:inline src="/oneko.js" data-cat="/images/oneko-blackcat.png"></script>
  </body>
</html>
