---
import { STATES, CAT_THEME } from "../themes.js";
const isCatsPage = Astro.url.pathname.replace(/\/+$/, "") === "/cats";
---

<script>
  import { STATES, CAT_THEME } from "../themes.js";

  const isCatsPage = location.pathname.replace(/\/+$/, "") === "/cats";
  if (isCatsPage) sessionStorage.setItem("catThemeUnlocked", "true");

  const unlocked = sessionStorage.getItem("catThemeUnlocked") === "true";
  const states = unlocked ? [...STATES, CAT_THEME] : [...STATES];

  const root = document.documentElement;
  const button = document.querySelector(".avatar-btn");
  const avatar = document.querySelector(".avatar-icon");

  const STORAGE_KEY = "themeIndex";
  const saveIndex = (i) => {
    try {
      localStorage.setItem(STORAGE_KEY, String(i));
    } catch (e) {}
  };
  const loadIndex = () => {
    try {
      const v = parseInt(localStorage.getItem(STORAGE_KEY), 10);
      return Number.isInteger(v) ? v : 0;
    } catch (e) {
      return 0;
    }
  };

  let index = 0;

  function apply(state) {
    root.style.setProperty("--primary-color", state.bg);
    root.style.setProperty("--secondary-color", state.fg);
    avatar.src = state.img;
  }

  states.forEach((state) => {
    const preload = new Image();
    preload.src = state.img;
  });

  if (isCatsPage) {
    index = states.length - 1;
  } else {
    const saved = loadIndex();
    index = saved >= 0 && saved < states.length ? saved : 0;
  }
  apply(states[index]);

  button.addEventListener("click", () => {
    index = (index + 1) % states.length;
    apply(states[index]);
    saveIndex(index);
  });
</script>

<div class="avatar">
  <button type="button" class="avatar-btn" aria-label="Change theme">
    <img
      class="avatar-icon"
      src={isCatsPage ? "/images/cat-avatar.jpg" : "/images/RukawaKaede.jpg"}
      alt="logo"
    />
    <!-- Set the saved avatar image before first paint (no flash). -->
    <script is:inline define:vars={{ STATES, CAT_THEME, isCatsPage }}>
      if (!isCatsPage) {
        try {
          const states =
            sessionStorage.getItem("catThemeUnlocked") === "true"
              ? [...STATES, CAT_THEME]
              : STATES;
          const v = parseInt(localStorage.getItem("themeIndex"), 10);
          if (v > 0 && v < states.length) {
            document.querySelector(".avatar-icon").src = states[v].img;
          }
        } catch (e) {}
      }
    </script>
    <p class="avatar-poke">[ poke me ]</p>
  </button>
  <h1 class="avatar-name">[ biswaszin ]</h1>
</div>
