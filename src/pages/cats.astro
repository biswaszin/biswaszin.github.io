---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import bolt1 from "../assets/cat/bolt-1.jpg";
import bolt2 from "../assets/cat/bolt-2.jpg";
import bolt3 from "../assets/cat/bolt-3.jpg";
import bolt4 from "../assets/cat/bolt-4.jpg";
import monu2 from "../assets/cat/monu-2.jpg";
import monu4 from "../assets/cat/monu-4.jpg";
import monu5 from "../assets/cat/monu-5.jpg";
import monu7 from "../assets/cat/monu-7.jpg";

const cats = [
  { name: "Bolt", img: bolt1 },
  { name: "Bolt", img: bolt2 },
  { name: "Bolt", img: bolt3 },
  { name: "Bolt", img: bolt4 },
  { name: "Monu", img: monu2 },
  { name: "Monu", img: monu4 },
  { name: "Monu", img: monu5 },
  { name: "Monu", img: monu7 },
];
---

<Layout title="cats(s)">
  <section class="cats-section">
    <div class="container">
      <h1>[ meow ]</h1>
      <div class="cat-grid">
        {cats.map((cat) => (
          <article class="cat-card">
            <Image src={cat.img} alt={cat.name} width={500} />
          </article>
        ))}
      </div>
      <script is:inline>
        const grid = document.querySelector(".cat-grid");
        const cards = Array.from(grid.children);

        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [cards[i], cards[j]] = [cards[j], cards[i]];
        }

        const scatter = window.innerWidth > 560;
        cards.forEach((card) => {
          if (scatter)
            card.style.marginTop = Math.floor(Math.random() * 97) + "px";
        });

        grid.classList.add("cat-grid--js");

        function columnsForWidth() {
          if (window.innerWidth > 900) return 4;
          if (window.innerWidth > 560) return 2;
          return 1;
        }

        let currentCols = 0;
        function layout() {
          const n = columnsForWidth();
          if (n === currentCols) return;
          currentCols = n;
          grid.innerHTML = "";
          const cols = [];
          for (let i = 0; i < n; i++) {
            const col = document.createElement("div");
            col.className = "cat-col";
            grid.appendChild(col);
            cols.push(col);
          }
          cards.forEach((card, i) => cols[i % n].appendChild(card));
        }

        layout();
        window.addEventListener("resize", layout);
      </script>
    </div>
  </section>
</Layout>

<style>
  .cat-grid {
    columns: 4;
    column-gap: 1.5rem;
  }

  .cat-grid--js {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .cat-col {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .cat-card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .cat-card img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .cat-grid {
      columns: 2;
    }
  }

  @media (max-width: 560px) {
    .cat-grid {
      columns: 1;
    }
  }
</style>
