---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";

import bolt1 from "../assets/cat/bolt-1.jpg";
import bolt2 from "../assets/cat/bolt-2.jpg";
import bolt3 from "../assets/cat/bolt-3.jpg";
import bolt4 from "../assets/cat/bolt-4.jpg";
import monu2 from "../assets/cat/monu-2.jpg";
import monu4 from "../assets/cat/monu-4.jpg";
import monu5 from "../assets/cat/monu-5.jpg";
import monu7 from "../assets/cat/monu-7.jpg";

const cats = [
  { name: "Bolt", img: bolt1 },
  { name: "Bolt", img: bolt2 },
  { name: "Bolt", img: bolt3 },
  { name: "Bolt", img: bolt4 },
  { name: "Monu", img: monu2 },
  { name: "Monu", img: monu4 },
  { name: "Monu", img: monu5 },
  { name: "Monu", img: monu7 },
];
---

<Layout title="cats(s)">
  <section class="cats-section">
    <div class="container">
      <h1>[ my cats ]</h1>
      <div class="cat-grid">
        {cats.map((cat) => (
          <article class="cat-card">
            <Image src={cat.img} alt={cat.name} width={500} />
          </article>
        ))}
      </div>
      <script is:inline>
        const grid = document.querySelector(".cat-grid");
        const cards = Array.from(grid.children);
        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [cards[i], cards[j]] = [cards[j], cards[i]];
        }
        const scatter = window.innerWidth > 560;
        cards.forEach((card) => {
          if (scatter) card.style.marginTop = Math.floor(Math.random() * 121) + "px";
          grid.appendChild(card);
        });
      </script>
    </div>
  </section>
</Layout>

<style>
  .cat-grid {
    columns: 4;
    column-gap: 1.5rem;
  }

  .cat-card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .cat-card img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  @media (max-width: 900px) {
    .cat-grid {
      columns: 2;
    }
  }

  @media (max-width: 560px) {
    .cat-grid {
      columns: 1;
    }
  }
</style>
